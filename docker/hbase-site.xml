<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>

  <!-- ZooKeeper -->
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>zookeeper</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.clientPort</name>
    <value>2181</value>
  </property>

  <!--
    IMPORTANT: file:/// (local FS) — pas HDFS.
    HDFS n'est pas dans ce setup Docker.
  -->
  <property>
    <name>hbase.rootdir</name>
    <value>file:///hbase-data</value>
  </property>

  <!-- Mode distribué pour avoir plusieurs RegionServers -->
  <property>
    <name>hbase.cluster.distributed</name>
    <value>true</value>
  </property>

  <!-- Réplication activée -->
  <property>
    <name>hbase.replication</name>
    <value>true</value>
  </property>

  <!-- Auto-split region à 256 MB -->
  <property>
    <name>hbase.hregion.max.filesize</name>
    <value>268435456</value>
  </property>

  <!-- Threads RegionServer -->
  <property>
    <name>hbase.regionserver.handler.count</name>
    <value>30</value>
  </property>

</configuration>